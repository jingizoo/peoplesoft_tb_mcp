# Copy to .env and fill in what you use. Everything here is optional for the
# bundled SQLite sample — these are for real connections only.

# --- Oracle (PeopleSoft FSCM database, read-only account recommended) ---
# Thin-mode DSN: host:port/service_name
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=

# --- SQL Server (only if db.backend = sqlserver) ---
MSSQL_CONN_STR=

# --- Confluence (company wiki) ---
# Cloud:  base URL like https://yourco.atlassian.net/wiki, plus email + API token
# Server/DC: base URL like https://wiki.yourco.com, leave email empty, token = PAT
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# Optional: restrict lookups to pages carrying these labels
CONFLUENCE_LABELS=

# --- Gemini via Vertex AI (uses Application Default Credentials) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Claude via the Anthropic API ---
# Only needed for llm.provider = claude. The SDK reads this itself; nothing
# in this application logs or echoes it. Leave blank if you sign in with
# the Anthropic CLI instead (ant auth login --no-launch-browser), which
# stores a profile the SDK also reads.
ANTHROPIC_API_KEY=

# --- Coupa (read-only procurement source) ---
# Leave COUPA_BASE_URL blank to use the bundled recorded fixtures. For OAuth
# client credentials, grant only the read scopes the connector uses, including
# core.inventory.receiving.read for dated receiving transactions. An API key
# may be supplied instead of the client id/secret.
COUPA_BASE_URL=
COUPA_API_KEY=
COUPA_CLIENT_ID=
COUPA_CLIENT_SECRET=
COUPA_SCOPE=core.invoice.read core.purchase_order.read core.inventory.receiving.read core.supplier.read

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434

# --- Misc ---
# Point the server/client at an alternate config file
PSTB_CONFIG=
# Override llm.provider without editing config.yaml (ollama | gemini | claude)
PSTB_LLM_PROVIDER=

# ---------------------------------------------------------------- PSQuery
# Executing an existing PSQuery through the Query Access Service. Discovery
# (search_ps_queries / describe_ps_query) is plain SQL and needs none of
# this; only EXECUTION does. Also set ps_api.enabled: true in config.yaml,
# then run: .venv/bin/python scripts/diagnose_psquery.py
#
# A PeopleSoft USER, not a database account. Queries run as this user and
# return what their permission lists allow — which is a governance
# improvement over the database account, and a reason figures may
# legitimately differ from the curated tools.
PSFT_QAS_USER=
PSFT_QAS_PASSWORD=
# The IB node that fronts QAS. A wrong node is the usual first 404; sites
# commonly use PSFT_FS, PSFT_HR, or a custom one.
PSFT_QAS_NODE=PSFT_FS
