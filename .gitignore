.venv/
__pycache__/
*.pyc
*.egg-info/
.env
sample_data/*.db
.DS_Store

# editor / local tooling settings
.vscode/
.idea/
*.local.json
logs/
config.yaml.bak-*
.setup-probe-config.yaml
BUILD_INFO.json
site_memory.json

# Per-deployment configuration. Every one of these is settings for THIS
# machine, so none of them is tracked and `git pull` cannot overwrite them.
# The tracked defaults ship as config.example.yaml / .env.example, and the
# app falls back to config.example.yaml until a config.yaml exists.
#
# NO TRAILING COMMENTS BELOW. git has no inline comment in this file: a
# "# note" after a pattern becomes part of the pattern, so the rule matches
# nothing and the file it was meant to protect is committed.
#
# yours — written by scripts/setup.py, or hand-edited
config.yaml
# written by the configuration console
config.local.yaml
config.local.yaml.bak-*

# Built by scripts/build_process_graph.py from this instance metadata.
process_graph.db
process_graph.db.building

# Built by scripts/build_entity_graph.py — derived business data.
entity_graph.db
entity_graph.db.building

# Built by scripts/build_metadata_catalog.py -- source structure, no rows.
metadata_catalog.db
metadata_catalog.db.building
metadata_catalog.db.status.json
metadata_catalog.db.status.json.building
.*metadata_catalog.db.status.json.*.building

# Per-source semantic catalogs and proven relationship graphs.
metadata_catalogs/*.db
metadata_catalogs/*.db.building
metadata_catalogs/*.db.status.json
metadata_catalogs/*.db.status.json.building
metadata_catalogs/.*.db.status.json.*.building

# Sensitive local eval evidence (answers/tool args) and review queues.
eval-*.json
*-eval.json
evals-output*.json
